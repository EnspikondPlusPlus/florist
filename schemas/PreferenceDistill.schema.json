          "type": "string"
        },
        "weight": {
          "maximum": 1,
          "minimum": -1,
          "title": "Weight",
          "type": "number"
        },
        "evidence": {
          "default": 1,
          "minimum": 1,
          "title": "Evidence",
          "type": "integer"
        }
      },
      "required": [
        "statement",
        "weight"
      ],
      "title": "LearnedStatement",
      "type": "object"
    }
  },
  "properties": {
    "statements": {
      "items": {
        "$ref": "#/$defs/LearnedStatement"
      },
      "maxItems": 8,
      "title": "Statements",
      "type": "array"
    }
  },
  "title": "PreferenceDistill",
  "type": "object"
}
