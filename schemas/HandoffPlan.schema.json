        "title": {
          "title": "Title",
          "type": "string"
        },
        "goal": {
          "default": "",
          "title": "Goal",
          "type": "string"
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "est_hours": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
